{
    "compilerOptions": {
        "module": "nodenext",
        "lib": ["esnext"],
        "types": ["node"],

        "erasableSyntaxOnly": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "isolatedDeclarations": true,

        "noEmit": true,
        "skipLibCheck": true,
        "declaration": true
    }
}
